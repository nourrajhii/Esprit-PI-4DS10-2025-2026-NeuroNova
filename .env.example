# ── EstateMind Platform — Environment Variables ───────────────────────────────
# 1. Copy:  cp .env.example .env
# 2. Fill in every value below
# 3. Run:   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVER HOST ───────────────────────────────────────────────────────────────
# IP or domain of the machine running docker compose
# Local dev: localhost
# VPS / cloud: your public IP or domain (e.g. 51.158.XX.XX or estatemind.example.com)
SERVER_HOST=localhost

# ── External AI APIs ──────────────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI — https://serpapi.com/dashboard
SERPAPI_KEY=your_serpapi_key_here

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Database: dcrawl  |  Collection: listings (shared by all services)
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/dcrawl?retryWrites=true&w=majority&appName=Cluster0&tlsAllowInvalidCertificates=true
MONGODB_URI=${DATABASE_URL}
SCRAPED_DB_URI=${DATABASE_URL}

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe payments ───────────────────────────────────────────────────────────
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PRICE_ID=price_YOUR_PRICE_ID_HERE

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=EstateMind <your_email@gmail.com>
SMTP_APP_NAME=EstateMind

# ── Twilio (optional SMS/WhatsApp notifications) ──────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# ── Tripo3D 3D Generation API ─────────────────────────────────────────────────
# Get your key at https://platform.tripo3d.ai
TRIPO_API_KEY=your_tripo3d_api_key_here
TRIPO_MODEL_VERSION=v2.5-20250123
TRIPO_POLL_TIMEOUT=360

# ── Frontend public URLs (seen by the browser — use SERVER_HOST above) ─────────
# For local dev these stay as localhost
# For VPS: replace localhost with your server IP or domain
NEXT_PUBLIC_VIAGRA_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_VILLA3D_API_URL=http://localhost:8056
FRONTEND_URL=http://localhost:3001
BACKEND_PUBLIC_URL=http://localhost:4000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Agent internal URLs (Docker service names — do NOT change these) ──────────
RECOMMENDER_URL=http://real-estate-advisor-backend:8001
DEVIS_URL=http://nour:8002
LEGAL_URL=http://nour2:8003
FORECAST_URL=http://immo-forecast:8004
PRICE_URL=http://price-predictor:8005
INVESTMENT_URL=http://investment-scorer:8006
GEO_URL=http://geo-advisor:8007
DHIA_URL=http://dhia:8055

# ── MySQL (for real_estate_advisor_backend) ────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_rootpass
MYSQL_DATABASE=real_estate_advisor_db
MYSQL_USER=advisor
MYSQL_PASSWORD=change_me_advisorpass

# ── Ollama (optional local LLM) ───────────────────────────────────────────────
# Uncomment the llm profile in docker-compose.yml to run Ollama in Docker
# docker exec -it immo-ollama ollama pull phi3:mini
OLLAMA_HOST=http://ollama:11434
