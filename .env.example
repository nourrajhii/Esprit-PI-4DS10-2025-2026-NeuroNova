# ── IMMO-AI Platform — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values before running docker compose up

# ── External AI APIs ──────────────────────────────────────────────────────────
# Google Gemini API key (used by dhia scraper)
GEMINI_API_KEY=AIzaSyBZOj9UYCiQKvC6NGt6yofJ1auF3K8oQtU

# SerpAPI key (used by dhia for property discovery)
SERPAPI_KEY=7b257bbba3adbb791ab55f1679eb0c44a18dcffc550fc2e875dacc797038b424

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Shared by: dhia scraper, real_estate_advisor_backend, VIAGRA orchestrator
# Database: dcrawl  |  Collection: listings
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/dcrawl?retryWrites=true&w=majority&appName=Cluster0&tlsAllowInvalidCertificates=true

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL exposed to browser — must be accessible from the user's machine
# For local dev: http://localhost:8000
# For production: https://your-domain.com/api
NEXT_PUBLIC_VIAGRA_URL=http://localhost:8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Agent internal URLs (used by VIAGRA — Docker service names) ───────────────
RECOMMENDER_URL=http://real-estate-advisor-backend:8001
DEVIS_URL=http://nour:8002
LEGAL_URL=http://nour2:8003
FORECAST_URL=http://immo-forecast:8004
PRICE_URL=http://price-predictor:8005
INVESTMENT_URL=http://investment-scorer:8006
GEO_URL=http://geo-advisor:8007
DHIA_URL=http://dhia:8055

# ── Tripo3D 3D Generation API ─────────────────────────────────────────────────
# Get your key at https://tripo3d.ai — used by the Villa 3D agent (port 8056)
TRIPO_API_KEY=tsk_c0-NGL4YYMvvLJykL54PXKLYIuX4NcIxdu4gnKQovGF
# Tripo3D model version — v3.1-20260211 is the latest and best
TRIPO_MODEL_VERSION=v3.1-20260211
# Max seconds to wait for a Tripo3D task (default 300 = 5 min)
TRIPO_POLL_TIMEOUT=300

# ── Frontend public URLs ───────────────────────────────────────────────────────
NEXT_PUBLIC_VILLA3D_API_URL=http://localhost:8056

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# After starting the stack, pull models with:
#   docker exec -it immo-ollama ollama pull llama3.2:3b
#   docker exec -it immo-ollama ollama pull llama3.2:1b
OLLAMA_HOST=http://ollama:11434
