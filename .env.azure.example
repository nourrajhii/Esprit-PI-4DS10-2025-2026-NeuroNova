# ═══════════════════════════════════════════════════════════════════════════════
#  EstateMind — Azure Cloud Environment
#  Copy this file to .env on your Azure VM:   cp .env.azure.example .env
#  Then fill in every value marked  ← FILL THIS
# ═══════════════════════════════════════════════════════════════════════════════

# ── YOUR AZURE VM PUBLIC IP (or domain name if you add one) ──────────────────
SERVER_HOST=YOUR_VM_PUBLIC_IP          # ← FILL THIS  e.g. 20.86.123.45

# ── External AI APIs ──────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY     # ← FILL THIS  (already working locally)
SERPAPI_KEY=YOUR_SERPAPI_KEY           # ← FILL THIS

# ── MongoDB Atlas (same as local — no change needed) ─────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/estatemind?retryWrites=true&w=majority
SCRAPED_DB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/dcrawl?retryWrites=true&w=majority
DATABASE_URL=${MONGODB_URI}

# ── MySQL (local to VM container) ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=real_estate_advisor_db
MYSQL_USER=advisor
MYSQL_PASSWORD=advisorpass

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=YOUR_JWT_SECRET             # ← FILL THIS  (same as local is fine)
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET # ← FILL THIS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Nodemailer / Gmail) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_GMAIL@gmail.com         # ← FILL THIS
SMTP_PASS=YOUR_APP_PASSWORD            # ← FILL THIS  (Gmail app password)
SMTP_APP_NAME=EstateMind
EMAIL_FROM=EstateMind <YOUR_GMAIL@gmail.com>

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=YOUR_SID            # ← FILL THIS
TWILIO_AUTH_TOKEN=YOUR_TOKEN           # ← FILL THIS
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_KEY     # ← FILL THIS
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# ── Tripo3D (3D generation — no SD in cloud, Tripo API still works) ──────────
TRIPO_API_KEY=YOUR_TRIPO_KEY           # ← FILL THIS
TRIPO_MODEL_VERSION=v2.5-20250123
TRIPO_POLL_TIMEOUT=360

# ── Frontend URLs (baked at build time — must match SERVER_HOST above) ────────
NEXT_PUBLIC_VIAGRA_URL=http://YOUR_VM_PUBLIC_IP:8000
NEXT_PUBLIC_BACKEND_URL=http://YOUR_VM_PUBLIC_IP:4000
NEXT_PUBLIC_VILLA3D_API_URL=http://YOUR_VM_PUBLIC_IP:8056

# ── Node backend public URL ───────────────────────────────────────────────────
BACKEND_PUBLIC_URL=http://YOUR_VM_PUBLIC_IP:4000
FRONTEND_URL=http://YOUR_VM_PUBLIC_IP:3001
PORT=4000
NODE_ENV=production
